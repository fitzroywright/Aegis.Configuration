<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CommonRoot Condition="'$(CommonRoot)' == ''">$(MSBuildThisFileDirectory)..\..\Common</CommonRoot>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" /></ItemGroup><ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Aegis.Configuration.Domain/Aegis.Configuration.Domain.csproj" />
    <ProjectReference Include="../Aegis.Configuration.Application/Aegis.Configuration.Application.csproj" />
    <ProjectReference Include="../Aegis.Configuration.Infrastructure/Aegis.Configuration.Infrastructure.csproj" />
    <ProjectReference Include="$(CommonRoot)\Common.Diagnostics\Common.Diagnostics.csproj" AdditionalProperties="Configuration=$(Configuration)" />
    <ProjectReference Include="$(CommonRoot)\Common.Security\Common.Security.csproj" AdditionalProperties="Configuration=$(Configuration)" /><ProjectReference Include="$(CommonRoot)\Common.Security\Common.Security.Hosting\Common.Security.Hosting.csproj" /><ProjectReference Include="$(CommonRoot)\Common.Security\Common.Security.Plugin.ActiveDirectory\Common.Security.Plugin.ActiveDirectory.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(CommonRoot)\Common.Registration\Common.Registration.csproj" AdditionalProperties="Configuration=$(Configuration)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../scripts/**/*.sh" Link="scripts/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="contracts\**\*" CopyToPublishDirectory="Never" />
    <None Update="contracts\**\*" CopyToPublishDirectory="Never" />
  </ItemGroup>
<Target Name="StageAuthenticationPluginAfterBuild" AfterTargets="Build"><PropertyGroup><AuthenticationPluginOutput>$(CommonRoot)\Common.Security\Common.Security.Plugin.ActiveDirectory\bin\$(Configuration)\net10.0</AuthenticationPluginOutput></PropertyGroup><MakeDir Directories="$(OutDir)plugins" /><ItemGroup><AuthenticationPluginFiles Include="$(AuthenticationPluginOutput)\**\*" /></ItemGroup><Copy SourceFiles="@(AuthenticationPluginFiles)" DestinationFiles="@(AuthenticationPluginFiles->'$(OutDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" /><Error Condition="!Exists('$(OutDir)plugins\Common.Security.Plugin.ActiveDirectory.dll')" Text="Authentication plugin was not staged to $(OutDir)plugins." /></Target><Target Name="StageAuthenticationPluginForPublish" AfterTargets="Publish"><PropertyGroup><AuthenticationPluginOutput>$(CommonRoot)\Common.Security\Common.Security.Plugin.ActiveDirectory\bin\$(Configuration)\net10.0</AuthenticationPluginOutput></PropertyGroup><MakeDir Directories="$(PublishDir)plugins" /><ItemGroup><AuthenticationPluginPublishFiles Include="$(AuthenticationPluginOutput)\**\*" /></ItemGroup><Copy SourceFiles="@(AuthenticationPluginPublishFiles)" DestinationFiles="@(AuthenticationPluginPublishFiles->'$(PublishDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" /><Error Condition="!Exists('$(PublishDir)plugins\Common.Security.Plugin.ActiveDirectory.dll')" Text="Authentication plugin was not staged to $(PublishDir)plugins." /></Target></Project>
