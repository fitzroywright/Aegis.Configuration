{
  "CommonSecrets": {
    "Mode": "Production",
    "ProviderOrder": [ "PrimarySecrets" ],
    "WorkloadName": "Aegis.Configuration",
    "EnvironmentName": "Production",
    "Providers": {
      "PrimarySecrets": {
        "Type": "OpenBao",
        "Settings": {
          "Enabled": true,
          "RequireHttps": true,
          "MountPath": "secret",
          "BasePath": "aegis",
          "AuthMountPath": "approle",
          "SecretIdEnvironmentVariable": "OPENBAO_SECRET_ID",
          "DeleteSecretIdFileAfterRead": true,
          "ClearSecretIdEnvironmentVariableAfterRead": true,
          "RenewTokens": true,
          "RevokeTokenOnDispose": true
        }
      }
    }
  }
}
