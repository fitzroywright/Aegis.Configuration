{
  "Aegis": {
    "Registration": {
      "CredentialFile": "/var/lib/aegis/configuration/registration.key"
    }
  },
  "AegisConfiguration": {
    "ContractDirectory": "/var/lib/aegis/configuration/contracts",
    "DataDirectory": "data",
    "InstructionDirectory": "../../instruction-packs",
    "RegistrationClaimLifetimeMinutes": 30
  },
  "CommonSecrets": {
    "Mode": "Production",
    "ProviderOrder": [
      "PrimarySecrets"
    ],
    "Providers": {
      "PrimarySecrets": {
        "Type": "OpenBao",
        "Settings": {
          "Enabled": true,
          "RequireHttps": true
        }
      }
    },
    "WorkloadName": "Aegis.Configuration"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AuthenticationPlugin": {
    "Enabled": true,
    "AssemblyPath": "plugins/Common.Security.Plugin.ActiveDirectory.dll",
    "Settings": {
      "Domain": "",
      "SearchBase": "",
      "Port": 636,
      "TimeoutSeconds": 5,
      "Servers": [],
      "AdministrativeGroups": []
    }
  }
}
