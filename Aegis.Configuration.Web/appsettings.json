{
  "Aegis": {
    "Operations": {
      "Url": "http://127.0.0.1:5100"
    },
    "Registration": {
      "CredentialFile": "/var/lib/aegis/configuration/registration.key"
    }
  },
  "AegisConfiguration": {
    "ContractDirectory": "/var/lib/aegis/configuration/contracts",
    "DataDirectory": "data",
    "InstructionDirectory": "../../instruction-packs"
  },
  "CommonSecrets": {
    "Mode": "Production",
    "ProviderOrder": [
      "OpenBao"
    ],
    "WorkloadName": "Aegis.Configuration"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
