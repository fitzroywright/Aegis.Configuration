<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CommonSecretsProject Condition="Exists('../../Common/Common.Secrets/Common.Secrets.csproj')">../../Common/Common.Secrets/Common.Secrets.csproj</CommonSecretsProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Aegis.Configuration.Domain/Aegis.Configuration.Domain.csproj" />
    <ProjectReference Include="../Aegis.Configuration.Application/Aegis.Configuration.Application.csproj" />
    <ProjectReference Include="$(CommonSecretsProject)" Condition="'$(CommonSecretsProject)' != ''" />
  </ItemGroup>
  <Target Name="RequireCommonProjects" BeforeTargets="PrepareForBuild" Condition="'$(CommonSecretsProject)' == ''">
    <Error Text="Common.Secrets must be cloned under ../Common relative to Aegis.Configuration." />
  </Target>
</Project>
