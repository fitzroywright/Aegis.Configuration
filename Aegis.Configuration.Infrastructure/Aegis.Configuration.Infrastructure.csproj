<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CommonSecretsProject Condition="Exists('../../Common/Common.Secrets/Common.Secrets.csproj')">../../Common/Common.Secrets/Common.Secrets.csproj</CommonSecretsProject>
    <CommonDiagnosticsProject Condition="Exists('../../Common/Common.Diagnostics/Common.Diagnostics.csproj')">../../Common/Common.Diagnostics/Common.Diagnostics.csproj</CommonDiagnosticsProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <ProjectReference Include="../Aegis.Configuration.Domain/Aegis.Configuration.Domain.csproj" />
    <ProjectReference Include="../Aegis.Configuration.Application/Aegis.Configuration.Application.csproj" />
    <ProjectReference Include="$(CommonSecretsProject)" Condition="'$(CommonSecretsProject)' != ''" />
    <ProjectReference Include="$(CommonDiagnosticsProject)" Condition="'$(CommonDiagnosticsProject)' != ''" />
  </ItemGroup>
  <Target Name="RequireCommonProjects" BeforeTargets="PrepareForBuild" Condition="'$(CommonSecretsProject)' == '' Or '$(CommonDiagnosticsProject)' == ''">
    <Error Text="Common.Secrets and Common.Diagnostics must be cloned under ../Common relative to Aegis.Configuration." />
  </Target>
</Project>
