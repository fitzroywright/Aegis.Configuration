<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CommonSecretsProject Condition="Exists('../../../Common.Secrets/Common.Secrets.csproj')">../../../Common.Secrets/Common.Secrets.csproj</CommonSecretsProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <ProjectReference Include="../Aegis.Configuration.Domain/Aegis.Configuration.Domain.csproj" />
    <ProjectReference Include="../Aegis.Configuration.Application/Aegis.Configuration.Application.csproj" />
    <ProjectReference Include="$(CommonSecretsProject)" Condition="'$(CommonSecretsProject)' != ''" />
  </ItemGroup>
  <Target Name="RequireCommonSecrets" BeforeTargets="PrepareForBuild" Condition="'$(CommonSecretsProject)' == ''">
    <Error Text="Common.Secrets project was not found. Clone Common.Secrets beside Aegis.Configuration." />
  </Target>
</Project>
